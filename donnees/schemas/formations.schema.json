{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Formations lunaires",
 "type": "object",
 "required": [
  "formations"
 ],
 "properties": {
  "formations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "nom",
     "lon_deg",
     "lat_deg",
     "description"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^lune:"
     },
     "nom": {
      "type": "string",
      "minLength": 1
     },
     "lon_deg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
     },
     "lat_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
     },
     "priorite": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "description": {
      "type": "string",
      "minLength": 20
     },
     "mesures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "d": {
        "type": [
         "number",
         "array"
        ]
       },
       "rh": {
        "type": [
         "number",
         "array"
        ]
       },
       "dp": {
        "type": [
         "number",
         "array"
        ]
       },
       "dpm": {
        "type": [
         "number",
         "array"
        ]
       },
       "fl": {
        "type": [
         "number",
         "array"
        ]
       },
       "pk": {
        "type": [
         "number",
         "array"
        ]
       },
       "hh": {
        "type": [
         "number",
         "array"
        ]
       },
       "st": {
        "type": [
         "number",
         "array"
        ]
       },
       "sp": {
        "type": [
         "number",
         "array"
        ]
       }
      }
     }
    }
   }
  }
 }
}