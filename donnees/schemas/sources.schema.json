{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Registre des sources",
 "type": "object",
 "required": [
  "intro",
  "categories"
 ],
 "properties": {
  "categories": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "liens"
    ],
    "properties": {
     "liens": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "titre",
        "url"
       ],
       "properties": {
        "url": {
         "type": "string",
         "pattern": "^https?://"
        },
        "licence": {
         "type": [
          "string",
          "null"
         ]
        },
        "statut": {
         "enum": [
          "verifiee",
          "audit",
          "citation",
          "non-incluse",
          "choix",
          "a-verifier"
         ],
         "description": "verifiee : licence vérifiée à la source ; audit : relevée à l'audit des droits de la 0.87, non revérifiée ; citation : référence citée, aucun contenu protégé repris ; non-incluse : données téléchargées par l'utilisateur ; a-verifier : à confirmer ; choix : licence retenue par l'auteur quand les textes sont ambigus"
        },
        "verification": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}