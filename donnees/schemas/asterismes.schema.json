{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Astérismes",
 "type": "object",
 "required": [
  "objets"
 ],
 "properties": {
  "objets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "nom",
     "etoiles",
     "source"
    ],
    "properties": {
     "etoiles": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "ra_deg",
        "dec_deg",
        "mag"
       ]
      }
     },
     "source": {
      "type": "string",
      "minLength": 10
     },
     "contour": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "array",
       "minItems": 4,
       "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       }
      }
     }
    }
   }
  }
 }
}